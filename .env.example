DATABASE_URL=postgres://izalapp:izalapp@localhost:5433/izalapp

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Time zone used to decide which "quincena" today belongs to
TZ=America/Mexico_City

# Set to true once your account exists to block new sign-ups
DISABLE_SIGNUP=false

# --- Production only (docker-compose.prod.yml) ---
# Letters and digits only, since it goes inside the database URL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_PORT=3000
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
